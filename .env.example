# URL interna del backend de DolyNation (dolynation-atl-back).
#
# La consume SOLO el servidor de Next.js, en el proxy (`src/app/api/v1/[...path]/route.ts`).
# No lleva el prefijo NEXT_PUBLIC_ a propósito: así no se compila en el bundle
# del navegador y la dirección del backend no se filtra al cliente.
#
# En Docker Compose, el backend es el servicio `backend` de la red `doly-dev-net`.
# Fuera de Docker, se pone el host y el puerto reales.
BACKEND_INTERNAL_URL=http://backend:3333/api/v1

# Habilita la biblioteca interactiva /design-system en producción solo si es "true".
# Por defecto está activa en desarrollo y desactivada en producción.
# ENABLE_DESIGN_SYSTEM=true

# Hosts desde los que se permite el dev server de Next (admite comodines:
# `**.yacaterkos.tech` matchea cualquier subdominio, no el apex).
#
# Next 16 bloquea los recursos cross-site del dev server (`/_next/*`) cuando el
# `Origin` de la petición no está en `allowedDevOrigins`. El websocket de HMR
# (`/_next/hmr`) también: Next responde con un 403 sin cabeceras HTTP y el
# proxy de Cloudflare lo traduce a un 520.
#
# Solo aplica al dev server. En rehearsal, staging y producción la app corre
# compilada (`output: 'standalone'`), sin HMR y sin websocket.
#
# En el ambiente de desarrollo la define la variable de environment
# `NEXT_ALLOWED_DEV_ORIGINS` del repo `dolynation-tonatiuh-front`.
NEXT_ALLOWED_DEV_ORIGINS=**.yacaterkos.tech

# URL pública opcional para etiquetas canónicas, Open Graph, robots.txt y sitemap.xml.
# Si no se define, se resuelve automáticamente desde las cabeceras de red del proxy
# (X-Forwarded-Host / Host y X-Forwarded-Proto) o usa https://yacaterkos.tech.
# SITE_URL=https://yacaterkos.tech
