# URL interna del backend de DolyNation (dolynation-atl-back).
#
# La consume SOLO el servidor de Next.js, en el proxy (`src/app/api/v1/[...path]/route.ts`).
# No lleva el prefijo NEXT_PUBLIC_ a propósito: así no se compila en el bundle
# del navegador y la dirección del backend no se filtra al cliente.
#
# En Docker Compose, el backend es el servicio `backend` de la red `doly-dev-net`.
# Fuera de Docker, se pone el host y el puerto reales.
BACKEND_INTERNAL_URL=http://backend:3333/api/v1
